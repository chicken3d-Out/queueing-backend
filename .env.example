# Copy to .env and fill in real values. Never commit the real .env.

# Render gives you this directly on your Postgres instance page — use the
# "Internal Database URL" if the backend web service is also on Render (same
# private network, faster, no external egress), or "External Database URL"
# if connecting from elsewhere.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random string — used to sign login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated list of origins allowed to call this API / open a socket
# connection. Set this to your actual Angular frontend URL(s) in production.
CORS_ORIGIN=http://localhost:4200

PORT=3000

# Optional, defaults to false. Include the real error message in API
# responses when something fails server-side — for temporary diagnosis only.
# Leave false in production; this endpoint set is public-facing in places
# (the login page, for instance) so leaking internals is a real risk.
APP_DEBUG=false
